# Apache (XAMPP) — project root
RewriteEngine On
RewriteBase /WhispVelvet/

# Site entry
DirectoryIndex index.html

# API + auth shortcuts
RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]
RewriteRule ^auth/(.*)$ backend/auth/$1 [L,QSA]

# Optional: open frontend pages without /frontend/ prefix
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+\.html)$ frontend/$1 [L]

# Block direct access to env
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
